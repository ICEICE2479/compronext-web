# ==========================================================
# ComproNext — Modern Serverless Stack (.env.example)
# คัดลอกไฟล์นี้เป็น .env.local เมื่อต้องการเชื่อมต่อ API จริง
# หากยังไม่ใส่คีย์ ระบบจะทำงานในโหมด Sandbox ที่กดทดสอบได้ครบทุกฟีเจอร์
# ==========================================================

# 1. เว็บ — Cloudflare (Pages / Workers)
# CLOUDFLARE_ACCOUNT_ID ใส่ในหัวข้อสร้างภาพด้านล่าง (ใช้ตัวเดียวกัน)
CF_PAGES_BRANCH=main

# 2. ข้อมูล — Neon Serverless PostgreSQL (Scale-to-zero & Branching)
NEON_PROJECT_ID=your-neon-project-id
NEON_BRANCH_NAME=main

# 3. ล็อกอิน — Clerk Authentication (Google / LINE / Social Login / 2FA)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# 4. อีเมล — Resend (React Email Transactional API)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="ComproNext <onboarding@resend.dev>"

# 5. ไฟล์ — UploadThing / Cloudflare R2 (Zero Egress Fee Storage)
UPLOADTHING_TOKEN=your-uploadthing-token
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=compronext-media
R2_PUBLIC_URL=https://media.compronext.app

# 6. ผู้ดูแลระบบ & ความปลอดภัย
# บังคับบน production: สุ่มอย่างน้อย 32 ตัวอักษร เช่น `openssl rand -hex 32` (ไม่ตั้ง = ล็อกอินไม่ได้)
ADMIN_SESSION_SECRET=
# อีเมลแอดมินที่รับรหัส OTP หลังบ้านได้ (คั่นด้วย ,) — อีเมลอื่นจะไม่ได้รับรหัส
ADMIN_EMAILS=
# รหัสผ่านแอดมินสำรอง (ไม่บังคับ, ยาว ≥12 ตัว) — ตอน dev ถ้าไม่ตั้งจะใช้ your-admin-passcode ซึ่งใช้บน production ไม่ได้
ADMIN_DEMO_PASSCODE=

# 7. ส่งอีเมล OTP ผ่าน SMTP (เช่น Gmail App Password) — ถ้าไม่ตั้งจะใช้ Resend ด้านบน
SMTP_USER=
SMTP_PASS=

# 8. AI จัดห้อง (/design)
# วิเคราะห์รูปห้อง + เลือกสินค้า (ไม่ตั้ง = ใช้ระบบจับคำสำคัญแบบพื้นฐาน)
ANTHROPIC_API_KEY=
AI_TEXT_MODEL=claude-sonnet-5-5
# สร้างภาพห้องที่จัดแล้ว (ไม่ตั้ง = แนะนำสินค้าได้ แต่ไม่สร้างภาพ)
# สร้างภาพห้อง (ใส่อย่างใดอย่างหนึ่ง หรือทั้งคู่ — Gemini ก่อน ไม่ได้ค่อยใช้ Cloudflare)
# Gemini: ต้องเปิด billing ที่ aistudio.google.com
GEMINI_API_KEY=
# Cloudflare Workers AI (ฟรีวันละ 10,000 Neurons): dash.cloudflare.com → Account ID + API Token (template "Workers AI")
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AI_IMAGE_MODEL=gemini-2.5-flash-image
# จำนวนครั้งต่อวัน (คุมค่าใช้จ่าย)
AI_DAILY_LIMIT_GUEST=2
AI_DAILY_LIMIT_USER=10

# 9. ฐานข้อมูลจริง (Neon / Supabase Postgres) — ตั้งแล้วระบบย้ายข้อมูลจาก .data ขึ้นให้อัตโนมัติครั้งแรก
DATABASE_URL=

# 10. ที่เก็บไฟล์อัปโหลด (รูปสินค้า / โมเดล 3D) บน Vercel — สร้างจาก Vercel → Storage → Blob
BLOB_READ_WRITE_TOKEN=

# 11. ที่อยู่เว็บจริง (ใช้กับ LINE Login, sitemap, รูปแชร์) เช่น https://compronext.app
NEXT_PUBLIC_SITE_URL=

# 12. ล็อกอินด้วย LINE — สร้าง LINE Login channel ที่ developers.line.biz
#     ตั้ง Callback URL เป็น <NEXT_PUBLIC_SITE_URL>/api/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# 13. สร้างโมเดล 3D จากรูปสินค้าอัตโนมัติ (Meshy) — https://www.meshy.ai
MESHY_API_KEY=

# 14. ล็อกอินด้วย Google — console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
#     Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 15. เช็กราคากับร้านอัตโนมัติวันละครั้ง (Vercel Cron ส่งค่านี้มาเอง) — สุ่มอย่างน้อย 16 ตัว
#     สร้าง: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# 16. แจ้งเตือนบนมือถือ/คอม (ข้อความจากร้าน, ของลดราคา) — สร้าง: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 17. แจ้งเตือนเมื่อเว็บมี error / cron ล้มเหลว — Webhook URL ของ Discord, Slack หรือ Google Chat
ALERT_WEBHOOK_URL=

# 18. ลิงก์ affiliate (ได้ค่าคอมเมื่อลูกค้าซื้อ) — มี {url} = ห่อลิงก์, ไม่มี = ต่อท้ายพารามิเตอร์
AFFILIATE_SHOPEE=
AFFILIATE_LAZADA=
AFFILIATE_JIB=
AFFILIATE_ADVICE=
AFFILIATE_IHAVECPU=
AFFILIATE_IKEA=
AFFILIATE_BANANA=
AFFILIATE_AMAZON=

