{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/prices?limit=60",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 2 * * 1"
    }
  ]
}